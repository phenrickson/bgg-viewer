# Copy to .env for local dev (.env is gitignored). Values grow as phases land.

# --- Auth (PR 2) ---
# Secret used to HMAC-sign the session cookie. Generate a long random string.
SESSION_SECRET=
# Shared invite code required to register (reuse dash-viewer's value to keep
# existing access working).
REGISTRATION_CODE=
# Dev-only: set to any email to skip the login flow locally (dev builds only).
# Unset to exercise the real login/register/logout flow.
DEV_AUTH_EMAIL=

# --- GCP / BigQuery (PR 2 auth reads core.users; uses ADC locally) ---
GCP_PROJECT_ID=bgg-data-warehouse

# --- Offline mode (local dev only) ---
# Set to 1 to work with no network: the catalog is served from .cache/catalog.arrow.gz
# (written by an earlier online run) and game pages render from that cached catalog instead
# of the warehouse. Description, box art, play time, similar games, and per-count vote
# totals are unavailable offline. Ignored in production builds.
OFFLINE=

# --- Warehouse read API (PR 3) ---
# Base URL of the gated warehouse Cloud Run service. Also the ID-token audience.
WAREHOUSE_API_URL=
# Dev-only escape hatch: paste an ID token (e.g. from an impersonated service
# account) to skip local ADC token minting. Leave unset in prod / on Cloud Run.
WAREHOUSE_ID_TOKEN=
