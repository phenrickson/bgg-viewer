# Local dev configuration. `just setup` copies this to .env (gitignored) and generates
# SESSION_SECRET; `just doctor` checks the result. Production gets these from Cloud Run.
#
# Two credential layers, and they are independent:
#   1. App login  — who the app thinks you are. Skip it with DEV_AUTH_EMAIL.
#   2. GCP access — what the server can read. Always required; comes from gcloud, not .env.
#      `gcloud auth application-default login` (BigQuery/GCS via ADC) and
#      `gcloud auth login` (identity tokens for the gated warehouse API).
#
# Minimum for a browsable app: DEV_AUTH_EMAIL + GCP_PROJECT_ID + gcloud logged in.

# ---------------------------------------------------------------------------
# App login
# ---------------------------------------------------------------------------

# Dev only (ignored in production builds). Set to any email to skip the login screen:
# a session is fabricated in memory and core.users is never read. Unset to exercise the
# real login/register/logout flow, which needs SESSION_SECRET + REGISTRATION_CODE below.
DEV_AUTH_EMAIL=

# Dev only. Give the DEV_AUTH_EMAIL session a linked BGG username so the "My collection"
# toggle works without registering for real. Unset = no linked collection.
DEV_BGG_USERNAME=

# HMAC key for the session cookie. `just setup` generates one; any long random string works.
SESSION_SECRET=

# Invite code the /register page asks for. Only needed when DEV_AUTH_EMAIL is unset and you
# want to create a real account in core.users. Ask Phil for the shared value.
REGISTRATION_CODE=

# ---------------------------------------------------------------------------
# GCP
# ---------------------------------------------------------------------------

# BigQuery project holding the warehouse datasets (analytics, predictions, core, collections).
# Credentials come from ADC, not from here.
GCP_PROJECT_ID=bgg-data-warehouse

# Bucket holding the CI-built catalog artifact. Defaults to <GCP_PROJECT_ID>-bgg-viewer-artifacts.
# Locally this path usually fails (signing a GCS URL needs a service-account key that user ADC
# doesn't have) and the server falls back to building the catalog from BigQuery — the
# "[catalog] GCS path failed, falling back to BigQuery build" log line is expected in dev.
CATALOG_BUCKET=

# Set to `bigquery` to skip the GCS attempt entirely and always build from BigQuery.
# Silences the fallback log locally; in prod it's the no-redeploy escape hatch.
CATALOG_SOURCE=

# ---------------------------------------------------------------------------
# Gated Cloud Run services (game detail pages, collection sync)
# ---------------------------------------------------------------------------

# Base URL of the warehouse read API (bgg-data-warehouse repo). Game detail pages proxy it
# for description, box art, play time, similar games, and vote totals. Unset = those pages
# fail; the catalog/Explore pages still work. Also the ID-token audience.
# Locally the server mints the token via `gcloud auth print-identity-token`, so `gcloud auth
# login` must be done and your account must have run.invoker on the service.
WAREHOUSE_API_URL=

# Dev-only escape hatch: paste an ID token to skip gcloud minting. Leave unset on Cloud Run.
WAREHOUSE_ID_TOKEN=

# Base URL of the bgg-collection-scoring service that syncs a linked BGG collection. Unset =
# linking a collection logs an error and skips the sync; nothing else breaks. Same token rules
# as WAREHOUSE_API_URL.
COLLECTION_SYNC_SERVICE_URL=

# Dev-only escape hatch, same idea as WAREHOUSE_ID_TOKEN.
COLLECTION_SYNC_ID_TOKEN=

# ---------------------------------------------------------------------------
# Offline
# ---------------------------------------------------------------------------

# Dev only. Set to 1 to run with no network: the catalog is served from .cache/catalog.arrow.gz
# (written by an earlier online run) and game pages render from that cached catalog. Description,
# box art, play time, similar games, and vote totals are unavailable. `just dev-offline` sets
# this for you.
OFFLINE=
